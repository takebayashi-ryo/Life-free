{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-free",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // 画面は SPA。/api/* 以外は静的ファイル（なければ index.html）を返す
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-free",
      "database_id": "fd227b22-e4b1-45a9-9fea-26376c37ba79",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 2026-11-08 に作成した Cloudflare Access の認証設定
    "ACCESS_TEAM_DOMAIN": "odd-snowflake-1e55.cloudflareaccess.com",
    "ACCESS_AUD": "2b230ee326d921a08cc1531a7b813f40a89776ff025bbac381bd543fb2aee734"
  },
  "observability": { "enabled": true }
}
